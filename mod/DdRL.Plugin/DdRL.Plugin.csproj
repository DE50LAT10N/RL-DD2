<!--
  Builds the DDRL BepInEx plugin for Darkest Dungeon II.
  Defines target framework, NuGet sources, and plugin/runtime dependencies.
  Used by mod/install.ps1 and dotnet build during release preparation.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup>
    <BepInExPath Condition="'$(BepInExPath)' == ''">D:\SteamLibrary\steamapps\common\Darkest Dungeon® II\BepInEx</BepInExPath>
    <GameRoot Condition="'$(GameRoot)' == ''">D:\SteamLibrary\steamapps\common\Darkest Dungeon® II</GameRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HarmonyX" Version="2.13.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" Condition="Exists('$(BepInExPath)\core\BepInEx.dll')">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(GameRoot)\Darkest Dungeon II_Data\Managed\UnityEngine.dll')">
      <HintPath>$(GameRoot)\Darkest Dungeon II_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(GameRoot)\Darkest Dungeon II_Data\Managed\UnityEngine.CoreModule.dll')">
      <HintPath>$(GameRoot)\Darkest Dungeon II_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
